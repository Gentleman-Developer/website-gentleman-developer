: /* Sliders */\n131: .app-screenshots {\n132:   display: flex;\n133:   justify-content: center;\n134:   align-items: center;\n135: }\n136: \n137: .slider {\n138:   position: relative;\n139:   width: 250px;\n140:   height: 520px;\n141:   border-radius: 35px;\n142:   overflow: hidden;\n143:   box-shadow: 0 20px 40px rgba(0,0,0,0.6);\n144:   border: 8px solid rgba(255, 255, 255, 0.1);\n145:   background: #000;\n146: }\n147: \n148: .slide {\n149:   position: absolute;\n150:   top: 0;\n151:   left: 0;\n152:   width: 100%;\n153:   height: 100%;\n154:   object-fit: cover;\n155:   opacity: 0;\n156:   transition: opacity 0.8s ease-in-out, transform 5s linear;\n157: }\n158: \n159: .slide.active {\n160:   opacity: 1;\n161:   transform: scale(1.05);\n162: }\n163: \n164: .slider-btn {\n165:   position: absolute;\n166:   top: 50%;\n167:   transform: translateY(-50%);\n168:   background: rgba(0, 0, 0, 0.5);\n169:   color: #fff;\n170:   border: 1px solid rgba(255, 255, 255, 0.2);\n171:   width: 36px;\n172:   height: 36px;\n173:   border-radius: 50%;\n174:   cursor: pointer;\n175:   font-size: 1rem;\n176:   display: flex;\n177:   align-items: center;\n178:   justify-content: center;\n179:   transition: background 0.3s, transform 0.3s, opacity 0.3s;\n180:   z-index: 10;\n181:   opacity: 0;\n182:   backdrop-filter: blur(4px);\n183: }\n184: \n185: .slider:hover .slider-btn {\n186:   opacity: 1;\n187: }\n188: \n189: .slider-btn:hover {\n190:   background: rgba(0, 0, 0, 0.8);\n191:   transform: translateY(-50%) scale(1.1);\n192: }\n193: \n194: .prev-btn { left: 10px; }\n195: .next-btn { right: 10px; }\n196: \n197: /* Privacy Policy Pages specific styles */\n198: .privacy-content {\n199:   max-width: 800px;\n200:   margin: 4rem auto;\n201:   padding: 3rem;\n202:   background: var(--glass-bg);\n203:   backdrop-filter: blur(15px);\n204:   -webkit-backdrop-filter: blur(15px);\n205:   border-radius: 20px;\n206:   box-shadow: 0 10px 40px var(--glass-shadow);\n207:   border: 1px solid var(--gl